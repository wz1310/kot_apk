<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ── Header ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="24dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <!-- Tombol Kembali — baris sendiri -->
        <Button
            android:id="@+id/btnBackToConnect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Kembali"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#44FFFFFF"
            android:layout_marginBottom="12dp"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Judul — baris sendiri -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Database"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dbServerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e8d5e0"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ── Content ──────────────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Error -->
                    <TextView
                        android:id="@+id/dbError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_error"
                        android:padding="12dp"
                        android:textColor="#d32f2f"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <!-- Database List -->
                    <LinearLayout
                        android:id="@+id/dbList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDatabases"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/btnManualInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Masukkan nama database secara manual"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:padding="14dp" />
                    </LinearLayout>

                    <!-- Manual Input -->
                    <LinearLayout
                        android:id="@+id/dbManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/dbManualInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#8a6a7e"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NAMA DATABASE"
                            android:textColor="#8a6a7e"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary"
                            app:hintTextColor="@color/primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputDbname"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Masukkan nama database"
                                android:textColor="#2c1a26"
                                android:textColorHint="#8a6a7e"
                                android:inputType="text"
                                android:imeOptions="actionDone"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnDbManualConnect"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:backgroundTint="@color/primary"
                            android:text="Buka Odoo"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp"
                            style="@style/Widget.MaterialComponents.Button" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
